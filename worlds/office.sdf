<?xml version="1.0"?>
<sdf version="1.8">
  <world name="office">
    <physics name="1ms" type="ode"><max_step_size>0.002</max_step_size><real_time_factor>1.0</real_time_factor></physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine></plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <gui fullscreen="0">
      <plugin filename="GzScene3D" name="3D View">
        <gz-gui><title>3D View</title><property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property></gz-gui>
        <engine>ogre2</engine><scene>scene</scene>
        <ambient_light>0.5 0.5 0.5</ambient_light><background_color>0.6 0.7 0.8</background_color>
        <camera_pose>0 -8 10 0 0.9 1.5708</camera_pose>
      </plugin>
    </gui>
    <light type="directional" name="sun"><cast_shadows>false</cast_shadows><pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse><direction>-0.3 0.2 -1</direction></light>
    <model name="ground"><static>true</static><link name="l">
      <collision name="c"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry></collision>
      <visual name="v"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
      <material><ambient>0.35 0.4 0.35 1</ambient><diffuse>0.35 0.4 0.35 1</diffuse></material></visual></link></model>
    <model name="wall_n"><static>true</static><pose>0 5.1 0.5 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>10.4 0.2 1</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>10.4 0.2 1</size></box></geometry>
      <material><ambient>0.7 0.7 0.75 1</ambient><diffuse>0.7 0.7 0.75 1</diffuse></material></visual></link></model>
    <model name="wall_s"><static>true</static><pose>0 -5.1 0.5 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>10.4 0.2 1</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>10.4 0.2 1</size></box></geometry>
      <material><ambient>0.7 0.7 0.75 1</ambient><diffuse>0.7 0.7 0.75 1</diffuse></material></visual></link></model>
    <model name="wall_e"><static>true</static><pose>5.1 0 0.5 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>0.2 10.0 1</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.2 10.0 1</size></box></geometry>
      <material><ambient>0.7 0.7 0.75 1</ambient><diffuse>0.7 0.7 0.75 1</diffuse></material></visual></link></model>
    <model name="wall_w"><static>true</static><pose>-5.1 0 0.5 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>0.2 10.0 1</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.2 10.0 1</size></box></geometry>
      <material><ambient>0.7 0.7 0.75 1</ambient><diffuse>0.7 0.7 0.75 1</diffuse></material></visual></link></model>
    <model name="inner_a"><static>true</static><pose>-1.5 -3.0 0.5 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>0.2 4.0 1</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.2 4.0 1</size></box></geometry>
      <material><ambient>0.7 0.7 0.75 1</ambient><diffuse>0.7 0.7 0.75 1</diffuse></material></visual></link></model>
    <model name="inner_b"><static>true</static><pose>-1.5 3.25 0.5 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>0.2 3.5 1</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.2 3.5 1</size></box></geometry>
      <material><ambient>0.7 0.7 0.75 1</ambient><diffuse>0.7 0.7 0.75 1</diffuse></material></visual></link></model>
    <model name="inner_c"><static>true</static><pose>3.0 1.5 0.5 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>4.0 0.2 1</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>4.0 0.2 1</size></box></geometry>
      <material><ambient>0.7 0.7 0.75 1</ambient><diffuse>0.7 0.7 0.75 1</diffuse></material></visual></link></model>
    <model name="pillar_1"><static>true</static><pose>2.0 -2.0 0.5 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>0.8 0.8 1</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.8 0.8 1</size></box></geometry>
      <material><ambient>0.7 0.7 0.75 1</ambient><diffuse>0.7 0.7 0.75 1</diffuse></material></visual></link></model>
    <model name="pillar_2"><static>true</static><pose>-3.5 2.5 0.5 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>0.6 0.6 1</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.6 0.6 1</size></box></geometry>
      <material><ambient>0.7 0.7 0.75 1</ambient><diffuse>0.7 0.7 0.75 1</diffuse></material></visual></link></model>
    <model name="pillar_3"><static>true</static><pose>0.8 3.5 0.5 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>0.5 0.5 1</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.5 0.5 1</size></box></geometry>
      <material><ambient>0.7 0.7 0.75 1</ambient><diffuse>0.7 0.7 0.75 1</diffuse></material></visual></link></model>
    <model name="keepout_zone"><static>true</static><pose>3.75 -2.75 0.005 0 0 0</pose>
      <link name="l"><visual name="v"><geometry><box><size>2.5 3.5 0.01</size></box></geometry>
      <material><ambient>0.9 0.1 0.1 1</ambient><diffuse>0.9 0.1 0.1 1</diffuse></material></visual></link></model>
    <model name="slow_zone"><static>true</static><pose>0.25 2.5 0.005 0 0 0</pose>
      <link name="l"><visual name="v"><geometry><box><size>2.5 3.0 0.01</size></box></geometry>
      <material><ambient>0.95 0.8 0.1 1</ambient><diffuse>0.95 0.8 0.1 1</diffuse></material></visual></link></model>
  </world>
</sdf>
